{
	"folders": [
		{
			// This Multi-Root Workspace includes;
			// - DEBCF      >> Main Repository
			// - DEBCF.wiki >> Github Wiki Repo
			// This ".code-workspace" is in "DEBCF" Folder to enable Backup of this file to the Main Repo, so it needs ".." to scope to the "../" folders, which are listed above.
			"path": ".."
		}
	],
	"settings": {
		"files.associations": {
			"*.txt": "stellaris",
			"*.gfx": "stellaris",
			"*.mod": "stellaris",
		},
		// Removed [] & [x] from TODO search results because it interfers with Markdown Lists in *.md files and causes false positives.
		"todo-tree.general.tags": [
			"BUG",
			"HACK",
			"FIXME",
			"TODO",
			"XXX"
		]
	},
	"extensions": {
		"recommendations": [
			"tboby.cwtools-vscode"
		]
	}
}